# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ===== Client (Next.js) =====

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# Playwright only writes these on failure; the journey spec keeps artifacts off.
test-results/
playwright-report/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem
*.key
*.p12
*.pfx
*.crt
*.cer
*.der
*.jks
*.keystore
*.mobileprovision

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example
*.env
*.env.local

# vercel
.vercel

# typescript
*.tsbuildinfo
client/next-env.d.ts

# ===== Server (Python/FastAPI) =====

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
server/venv/
server/.venv/

# Uploads (keep directory, ignore contents)
server/uploads/*
!server/uploads/.gitkeep

# Local databases, exports, captures, and generated private data
*.sqlite
*.sqlite3
*.db
*.dump
*.backup
*.sql.gz
*.csv.gz
uploads/
artifacts/
# Root-anchored: this group is for generated data dumps and exports. An
# unanchored `reports/` also matched client/app/business/reports/ and
# client/components/reports/, so the entire staff Reports feature was
# untracked and could never be committed.
/reports/
*.har

# Python and notebook state
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
ml/notebooks/
ml/mlruns/
ml/mlflow.db

# Local agent/editor state is not part of the portfolio mirror
.claude/
.codex/
.agents/
.idea/
.vscode/

# Local public-mirror exports
portfolio-export/
