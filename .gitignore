# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# ===== Client (Next.js) =====

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# production
build/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env.*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
client/next-env.d.ts

# ===== Server (Python/FastAPI) =====

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Virtual environment
server/venv/
server/.venv/

# Uploads (keep directory, ignore contents)
server/uploads/*
!server/uploads/.gitkeep
