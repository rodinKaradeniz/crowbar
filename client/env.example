# Backend (existing)
NEXT_PUBLIC_API_URL=http://localhost:8000

# Base URL where widget.js is hosted, used to build the embeddable booking snippet.
# Placeholder default — set a real domain before any real deployment.
NEXT_PUBLIC_WIDGET_BASE_URL=https://crowbar.example

# Docs assistant (RAG) — server-side only; required for POST /api/business-docs-chat
OPENAI_API_KEY=
# Optional overrides:
# OPENAI_API_BASE=https://api.openai.com/v1
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small
# OPENAI_CHAT_MODEL=gpt-4o-mini
