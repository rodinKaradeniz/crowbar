# Public FastAPI URL. Browser WebSocket clients use this address.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Server-only FastAPI URL. On Railway, set this to the API service's private
# railway.internal address. It falls back to NEXT_PUBLIC_API_URL locally.
API_INTERNAL_URL=http://localhost:8000

# Base URL where widget.js is hosted, used to build the embeddable booking snippet.
# Placeholder default — set a real domain before any real deployment.
NEXT_PUBLIC_WIDGET_BASE_URL=https://crowbar.example

# Exact HTTP(S) origins allowed to embed /reserve/*, comma-separated. Omit to
# keep framing same-origin only. Wildcards are rejected.
RESERVATION_FRAME_ANCESTORS=

