# Copy this file to .env and update values
# cp env.example .env

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/slotera

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Stripe (optional for now)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Email (Resend) - required for confirmation emails
RESEND_API_KEY=re_xxxxx
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Slotera

# Google OAuth - required for online meeting links and Calendar sync
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:8000/api/auth/google/callback
# GOOGLE_CONNECT_SUCCESS_URL=http://localhost:3000/business/settings/account

# Twilio SMS - optional, enables SMS reservation reminders
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx  # must be E.164 format
