# Copy this file to .env and update values
# cp env.example .env

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crowbar

# Redis
REDIS_URL=redis://localhost:6379/0

# Redis-backed application rate limits (production requires true).
RATE_LIMIT_ENABLED=false
RATE_LIMIT_HMAC_SECRET=development-rate-limit-secret-not-for-production

# Private ML service
ML_SERVICE_URL=http://localhost:8001
# Set the same strong random value on the API and ML services in production.
ML_INTERNAL_TOKEN=development-ml-token-not-for-production

# Auth
SECRET_KEY=your-secret-key-change-in-production
PUBLIC_LINK_SECRET_KEY=development-public-link-secret-not-for-production
TABLE_QR_SECRET_KEY=development-table-qr-secret-not-for-production
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Pending/approved browser ordering authority, bounded to 30 minutes–24 hours.
TABLE_GUEST_SESSION_TTL_MINUTES=720

# Environment
ENVIRONMENT=development

# Public frontend origins allowed to call the API directly (JSON array).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
FRONTEND_URL=http://localhost:3000

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Email (Resend) - required for confirmation emails
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Crowbar

# Twilio SMS - optional, enables SMS reservation reminders
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
