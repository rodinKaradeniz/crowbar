# Copy this file to .env and update values
# cp env.example .env

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/crowbar

# Redis
REDIS_URL=redis://localhost:6379/0

# Private ML service
ML_SERVICE_URL=http://localhost:8001
# Set the same strong random value on the API and ML services in production.
# ML_INTERNAL_TOKEN=

# Auth
SECRET_KEY=your-secret-key-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Environment
ENVIRONMENT=development

# Public frontend origins allowed to call the API directly (JSON array).
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Storage
STORAGE_TYPE=local
UPLOAD_DIR=uploads

# Stripe (optional for now)
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=

# Email (Resend) - required for confirmation emails
RESEND_API_KEY=re_xxxxx
EMAIL_FROM_ADDRESS=onboarding@resend.dev
EMAIL_FROM_NAME=Crowbar

# Twilio SMS - optional, enables SMS reservation reminders
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=+1xxxxxxxxxx  # must be E.164 format
