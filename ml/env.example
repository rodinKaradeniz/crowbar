# Copy this file to .env and update values
# cp env.example .env

# Database (read-only access to the main app DB)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/rk_reservations

# Sync DB URL (for pandas read_sql)
DATABASE_URL_SYNC=postgresql://postgres:postgres@localhost:5432/rk_reservations

# Environment
ENVIRONMENT=development
LOG_LEVEL=INFO

# MLflow tracking (optional)
MLFLOW_TRACKING_URI=sqlite:///mlflow.db
